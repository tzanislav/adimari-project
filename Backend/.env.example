AWS_ACCESS_KEY_ID=<set>
AWS_SECRET_ACCESS_KEY=<set>
AWS_REGION=eu-west-1
S3_BUCKET_NAME="mesharch"
AWS_USE_PATH_STYLE_ENDPOINT=false
NODE_ENV=development
DEV_MODE=development
EMAILJS_PRIVATE_KEY= <set>
OPENAI_API_KEY=<set>
PORT=5001
# The backend must stay behind Nginx; never set this to a LAN/public address.
BACKEND_BIND_HOST=127.0.0.1
CLICKUP_API_KEY=<set>
CLICKUP_TEAM_ID=37458550
MONGODB_URI=<set>
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private File Server - a dedicated IAM identity and private S3 bucket.
# Do not reuse AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or S3_BUCKET_NAME above;
# those variables belong to the existing uploader/Rekognition integration. The NAS
# connector reuses this bucket only through separate, non-overlapping prefixes.
# Store real values only in the backend deployment's secret environment, never in Vite.
FILE_SERVER_AWS_ACCESS_KEY_ID=<set>
FILE_SERVER_AWS_SECRET_ACCESS_KEY=<set>
FILE_SERVER_AWS_REGION=eu-west-1
FILE_SERVER_BUCKET_NAME=<set>
FILE_SERVER_S3_PREFIX=files/
FILE_SERVER_PUBLIC_BASE_URL=http://localhost:5173

# Uploads use browser-to-S3 multipart URLs, so Express never receives file bytes.
# 50,000,000,000,000 bytes is S3's current 50 TB / 48.8 TiB multipart limit.
FILE_SERVER_MAX_UPLOAD_BYTES=50000000000000
FILE_SERVER_MULTIPART_PART_SIZE_BYTES=67108864
FILE_SERVER_UPLOAD_PART_URL_TTL_SECONDS=900
FILE_SERVER_DOWNLOAD_URL_TTL_SECONDS=300

# NAS connector (Phase 2B). It reuses the File Server bucket but operates only
# in the isolated prefixes below. Keep disabled until the backend connector API
# and Windows connector are deployed together.
NAS_CONNECTOR_ENABLED=false
# Set true only for an intentionally private/local HTTP deployment. It permits
# http:// and ws:// connector transport and removes the need for a local TLS proxy.
NAS_CONNECTOR_ALLOW_HTTP=false
NAS_CONNECTOR_AWS_ACCESS_KEY_ID=<set>
NAS_CONNECTOR_AWS_SECRET_ACCESS_KEY=<set>
NAS_CONNECTOR_AWS_REGION=eu-west-1
NAS_CONNECTOR_BUCKET_NAME=<same as FILE_SERVER_BUCKET_NAME>
NAS_CONNECTOR_CACHE_S3_PREFIX=nas-cache/
NAS_CONNECTOR_UPLOAD_STAGING_S3_PREFIX=nas-upload-staging/
NAS_CONNECTOR_THUMBNAIL_S3_PREFIX=nas-thumbnails/
NAS_CONNECTOR_CACHE_RETENTION_DAYS=10
NAS_CONNECTOR_THUMBNAIL_MAX_DIMENSION=320
NAS_CONNECTOR_MAX_UPLOAD_BYTES=50000000000000
NAS_CONNECTOR_BROWSER_UPLOAD_URL_TTL_SECONDS=900
NAS_CONNECTOR_TRANSFER_URL_TTL_SECONDS=3600
# Generate and store this as a backend-only secret (at least 32 random bytes).
# It HMAC-hashes legacy enrollment data and the local connector record.
NAS_CONNECTOR_AUTH_HMAC_SECRET=<generate-a-long-random-secret>
# The same 32-byte base64url key is entered once in each trusted Windows
# Connector Control Center. Generate, for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NAS_CONNECTOR_SHARED_SECRET=<generate-a-32-byte-base64url-key>
# Optional legacy-token compatibility only. The current shared-key connector
# does not use these settings.
# NAS_CONNECTOR_ENROLLMENT_TOKEN_TTL_SECONDS=900
# NAS_CONNECTOR_ENROLLMENT_RECOVERY_TTL_SECONDS=3600
NAS_CONNECTOR_HEARTBEAT_INTERVAL_SECONDS=30
# Optional. Defaults to three heartbeat intervals and must be at least two.
# Active connectors older than this are persisted as offline when an admin lists them.
NAS_CONNECTOR_HEARTBEAT_STALE_AFTER_SECONDS=90
# Persistent WebSocket presence complements the REST heartbeat and now carries
# only a non-executing durable index-root delivery. The public reverse proxy
# must additionally rate/connection limit this upgrade endpoint before traffic reaches Node.
NAS_CONNECTOR_CONTROL_PING_INTERVAL_SECONDS=30
NAS_CONNECTOR_CONTROL_UPGRADE_RATE_LIMIT_PER_MINUTE=30
# Lease for one durable `index_root` delivery. It governs WSS receipt only;
# the Phase 3A metadata scan has its own authenticated HTTPS lifecycle.
NAS_CONNECTOR_JOB_LEASE_SECONDS=90
