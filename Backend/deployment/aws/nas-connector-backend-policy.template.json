{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyNasConnectorPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__FILE_SERVER_BUCKET__",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "nas-cache/*",
            "nas-upload-staging/*",
            "nas-thumbnails/*"
          ]
        }
      }
    },
    {
      "Sid": "ManageNasConnectorObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::__FILE_SERVER_BUCKET__/nas-cache/*",
        "arn:aws:s3:::__FILE_SERVER_BUCKET__/nas-upload-staging/*",
        "arn:aws:s3:::__FILE_SERVER_BUCKET__/nas-thumbnails/*"
      ]
    }
  ]
}
