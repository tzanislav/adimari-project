{
  "Rules": [
    {
      "ID": "adimari-nas-cache-expire-after-10-days",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "nas-cache/"
      },
      "Expiration": {
        "Days": 10
      },
      "NoncurrentVersionExpiration": {
        "NoncurrentDays": 1
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    },
    {
      "ID": "adimari-nas-upload-staging-expire-after-1-day",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "nas-upload-staging/"
      },
      "Expiration": {
        "Days": 1
      },
      "NoncurrentVersionExpiration": {
        "NoncurrentDays": 1
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 1
      }
    },
    {
      "ID": "adimari-nas-thumbnails-abort-incomplete-uploads",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "nas-thumbnails/"
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    }
  ]
}
