# Copy to an Nginx site configuration only after replacing every __...__ value.
# Do not expose the Node/PM2 port publicly. This proxy must be the one trusted
# hop immediately in front of Backend/server.js.

server {
    listen 80;
    listen [::]:80;
    server_name __ADIMARI_PUBLIC_HOST__;

    # Keep or replace this location if the host obtains/renews certificates by
    # HTTP-01. The directory is an operator-owned path.
    location ^~ /.well-known/acme-challenge/ {
        root __ACME_WEBROOT__;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __ADIMARI_PUBLIC_HOST__;

    ssl_certificate     __TLS_FULLCHAIN_PATH__;
    ssl_certificate_key __TLS_PRIVATE_KEY_PATH__;

    # Keep TLS policy/ciphers in the host's centrally managed include where
    # possible. The certificate must chain to a CA trusted by the connector
    # Windows machine; self-signed production certificates are not supported.
    include __TLS_OPTIONS_INCLUDE_PATH__;

    # The API accepts only small JSON control-plane payloads. Browser file
    # bytes use S3 directly in later phases and must not be proxied through
    # Express.
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:__ADIMARI_BACKEND_PORT__;
        proxy_http_version 1.1;

        # Overwrite, rather than relay, client-supplied forwarding headers.
        # Backend/server.js uses req.secure for NAS connector routes, so
        # X-Forwarded-Proto must reach it as "https" after TLS termination.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace rather than append client-supplied X-Forwarded-For values.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;

    }
}
